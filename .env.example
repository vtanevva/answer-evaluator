# ============================================
# Answer Evaluator - Environment Variables
# ============================================

# Pinecone API Key (REQUIRED for vector database)
# Get your key from: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here

# OpenAI API Key (OPTIONAL - only if using OpenAI embeddings)
# Get your key from: https://platform.openai.com/api-keys
# Required only if you set `type: "openai"` in backend/settings.yaml embeddings config
OPENAI_API_KEY=sk-your-openai-api-key-here

# Groq API Key (OPTIONAL - only if using LLM arbiter)
# Get your key from: https://console.groq.com/keys
# Used for ultra-low-cost LLM verification with Llama 3.1 8B
# Required only if `llm_arbiter_enabled: true` in backend/settings.yaml
GROQ_API_KEY=gsk_your-groq-api-key-here

# ============================================
# Configuration Notes:
# ============================================
#
# NLI Models (DeBERTa):
#   - Downloaded automatically from HuggingFace on first use
#   - No API key needed
#   - Stored locally in ~/.cache/huggingface/
#
# Local Embedding Models (GTE-Multilingual, MiniLM, etc.):
#   - Downloaded automatically from HuggingFace on first use
#   - No API key needed
#   - Configured in backend/settings.yaml
#
# Grading Modes (set in backend/settings.yaml):
#   - "hybrid" (default): Uses all 4 tiers (cosine + NLI + LLM)
#   - "nli": NLI-first approach
#   - "embedding": Pure cosine similarity (legacy)
#
# To switch from local to OpenAI embeddings:
#   1. Add OPENAI_API_KEY to this .env file
#   2. Update backend/settings.yaml:
#      embeddings:
#        model: "text-embedding-ada-002"
#        type: "openai"
#        dimensions: 1536
#
# To enable LLM arbiter for complex cases:
#   1. Add GROQ_API_KEY to this .env file
#   2. Update backend/settings.yaml:
#      grading:
#        llm_arbiter_enabled: true
